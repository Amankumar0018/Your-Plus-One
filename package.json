{
  "name": "your-plus-one",
  "displayName": "Your +1",
  "description": "Your AI Engineering Companion",
  "version": "0.1.0",
  "publisher": "your-plus-one",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onView:yourplusone.welcomeView",
    "onCommand:yourplusone.openWelcome",
    "onCommand:yourplusone.testConnection",
    "onCommand:yourplusone.runMcpProof",
    "onCommand:yourplusone.assembleContext",
    "onCommand:yourplusone.runTurnWithContext",
    "onCommand:yourplusone.openNativeDiff",
    "onCommand:yourplusone.applyAcceptedHunks",
    "onCommand:yourplusone.undoLastTransaction"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yourplusone-sidebar",
          "title": "Your +1",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "yourplusone-sidebar": [
        {
          "type": "webview",
          "id": "yourplusone.welcomeView",
          "name": "Your +1"
        }
      ]
    },
    "commands": [
      {
        "command": "yourplusone.openWelcome",
        "title": "Open Welcome",
        "category": "Your +1"
      },
      {
        "command": "yourplusone.testConnection",
        "title": "Test TrueForge Connection",
        "category": "Your +1"
      },
      {
        "command": "yourplusone.runMcpProof",
        "title": "Run MCP Bridge Proof",
        "category": "Your +1"
      },
      {
        "command": "yourplusone.assembleContext",
        "title": "Assemble Context for Task",
        "category": "Your +1"
      },
      {
        "command": "yourplusone.runTurnWithContext",
        "title": "Run Agent Turn with Context",
        "category": "Your +1"
      },
      {
        "command": "yourplusone.openNativeDiff",
        "title": "Open Native Diff Preview",
        "category": "Your +1"
      },
      {
        "command": "yourplusone.applyAcceptedHunks",
        "title": "Apply Accepted Changes",
        "category": "Your +1"
      },
      {
        "command": "yourplusone.undoLastTransaction",
        "title": "Undo Last Applied Changes",
        "category": "Your +1"
      }
    ],
    "configuration": {
      "title": "Your +1",
      "properties": {
        "yourplusone.runtimeUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8790",
          "description": "Base URL of the TrueForge runtime server."
        },
        "yourplusone.apiToken": {
          "type": "string",
          "default": "trueforge-standalone",
          "description": "Authentication token for TrueForge in standalone mode."
        },
        "yourplusone.model": {
          "type": "string",
          "default": "",
          "description": "Optional model override (e.g. google-gemini/gemini-3-1-flash-lite). If empty, the first model configured in TrueForge is used."
        },
        "yourplusone.maxContextBudgetTokens": {
          "type": "integer",
          "default": 16000,
          "description": "Maximum token budget allocated for context assembly."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "0.183.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "~1.136.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
